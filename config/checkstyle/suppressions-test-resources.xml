<?xml version="1.0"?><!DOCTYPE suppressions PUBLIC
	"-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
	"https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
	<!-- Suppress each check in the directory whose test inputs intentionally violate it -->
	<suppress checks="AnnotationAlphabeticalOrderCheck" files="inputs[\\/]annotation[\\/]" />
	<suppress checks="EmptyBodyCheck" files="inputs[\\/]emptybody[\\/]" />
	<suppress checks="EmptySwitchCheck" files="inputs[\\/]emptyswitch[\\/]" />
	<suppress checks="InfiniteEmptyLoopCheck" files="inputs[\\/]emptybody[\\/]" />
	<suppress checks="MethodAlphabeticalOrderCheck" files="inputs[\\/]methodorder[\\/]" />
	<suppress checks="MethodAlphabeticalOrderCheck" files="inputs[\\/]overload[\\/]" />
	<suppress checks="NoArrayTrailingCommaCheck" files="inputs[\\/]arraycomma[\\/]" />
	<suppress checks="NoBlankLineBetweenSingleCasesCheck" files="inputs[\\/]singlecase[\\/]" />
	<suppress checks="NoCaseBracesCheck" files="inputs[\\/]casebraces[\\/]" />
	<suppress checks="NoUnnecessaryThisCheck" files="inputs[\\/]unnecessarythis[\\/]" />
	<suppress checks="OverloadMethodOrderCheck" files="inputs[\\/]overload[\\/]" />
	<suppress checks="PreferImportCheck" files="inputs[\\/]preferimport[\\/]" />
	<suppress checks="PreferPrefixIncrementCheck" files="inputs[\\/]prefix[\\/]" />
	<suppress checks="RedundantCastCheck" files="inputs[\\/]redundantcast[\\/]" />
	<suppress checks="RedundantNumericSuffixCheck" files="inputs[\\/]redundantsuffix[\\/]" />
	<suppress checks="SwitchCaseOrderCheck" files="inputs[\\/]switchorder[\\/]" />

	<!-- Suppress regex-based checks in the regex test directory (violation files intentionally break them) -->
	<suppress id="BlankLineAfterBreak" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoBlankLineAfterClassBrace" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoBlankLineBeforeClosingBrace" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoDoubleBlankLines" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoFinalParameters" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoSpaceIndent" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoTrailingNewline" files="inputs[\\/]regex[\\/]" />
	<suppress id="NoTrailingWhitespace" files="inputs[\\/]regex[\\/]" />

	<!-- Cross-check suppressions: test inputs for one check that naturally use constructs violating another -->
	<suppress checks="EmptyBodyCheck" files="inputs[\\/]astutil[\\/]" />
	<suppress checks="EmptySwitchCheck" files="inputs[\\/]switchorder[\\/]" />
	<suppress checks="NoBlankLineBetweenSingleCasesCheck" files="inputs[\\/]switchorder[\\/]" />
	<suppress checks="NoUnnecessaryThisCheck" files="inputs[\\/]fieldsorting[\\/]" />
	<suppress checks="OneStatementPerLine" files="inputs[\\/]controlflow[\\/]" />
	<suppress checks="PreferImportCheck" files="inputs[\\/]annotation[\\/]" />
	<suppress checks="PreferImportCheck" files="inputs[\\/]astutil[\\/]" />
	<suppress checks="PreferImportCheck" files="inputs[\\/]multilinecall[\\/]" />
	<suppress checks="PreferImportCheck" files="inputs[\\/]switchorder[\\/]" />
	<suppress checks="PreferPrefixIncrementCheck" files="inputs[\\/]redundantcast[\\/]" />
	<suppress checks="RedundantCastCheck" files="inputs[\\/]literalsuffix[\\/]" />
	<suppress checks="RedundantCastCheck" files="inputs[\\/]redundantsuffix[\\/]" />
	<suppress checks="RedundantNumericSuffixCheck" files="inputs[\\/]redundantcast[\\/]" />
	<suppress checks="RedundantNumericSuffixCheck" files="inputs[\\/]switchorder[\\/]" />
	<suppress checks="SimplifyBooleanExpression" files="inputs[\\/]multilinecall[\\/]" />
	<suppress checks="SimplifyBooleanExpression" files="inputs[\\/]patterninstanceof[\\/]" />
</suppressions>