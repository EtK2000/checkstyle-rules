<?xml version="1.0"?><!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Config for test resource files (src/test/resources).
     Enforces most rules from the main config. Each check is suppressed in its own
     test directory (where violation inputs intentionally break it). -->
<module name="Checker">
	<property name="charset" value="UTF-8" />
	<property name="severity" value="error" />

	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/suppressions-test-resources.xml" />
	</module>

	<!-- TABs for indentation -->
	<module name="RegexpSingleline">
		<property name="id" value="NoSpaceIndent" />
		<property name="format" value="^ (?!\*)(?!@)" />
		<property name="message" value="Use TABs for indentation, not spaces." />
	</module>

	<!-- No blank line after class/interface/enum/record opening brace -->
	<module name="RegexpMultiline">
		<property name="id" value="NoBlankLineAfterClassBrace" />
		<property name="format" value="(class|interface|enum|record)\s+\w[^{]*\{\s*\n\s*\n" />
		<property name="message" value="No blank line at start of a class/interface/enum/record." />
	</module>

	<!-- No blank line before closing brace -->
	<module name="RegexpMultiline">
		<property name="id" value="NoBlankLineBeforeClosingBrace" />
		<property name="format" value="\n[^\S\n]*\n[^\S\n]*\}" />
		<property name="message" value="No blank line before closing brace." />
	</module>

	<!-- No double blank lines -->
	<module name="RegexpMultiline">
		<property name="id" value="NoDoubleBlankLines" />
		<property name="format" value="\n\s*\n\s*\n" />
		<property name="message" value="No double blank lines." />
	</module>

	<!-- Blank line after break; before next case/default -->
	<module name="RegexpMultiline">
		<property name="id" value="BlankLineAfterBreak" />
		<property name="format" value="break\s*;\n[^\S\n]*(case |default[\s:])" />
		<property name="message"
			value="Add a blank line after break; before the next case/default." />
	</module>

	<!-- No trailing whitespace -->
	<module name="RegexpSingleline">
		<property name="id" value="NoTrailingWhitespace" />
		<property name="format" value="[ \t]+$" />
		<property name="message" value="No trailing whitespace." />
	</module>

	<!-- No trailing newline at end of file -->
	<module name="RegexpMultiline">
		<property name="id" value="NoTrailingNewline" />
		<property name="format" value="\n\z" />
		<property name="message" value="File must not end with a trailing newline." />
	</module>

	<!-- Enforce consistent line endings (LF) -->
	<module name="LineEnding" />

	<module name="TreeWalker">
		<!-- Custom checks -->
		<module name="com.etk2000.checkstyle.AnnotationOwnLineCheck" />
		<module name="com.etk2000.checkstyle.AnnotationSameLineCheck" />
		<module name="com.etk2000.checkstyle.ClassStructureOrderCheck" />
		<module name="com.etk2000.checkstyle.ConstructorAssignmentOrderCheck" />
		<module name="com.etk2000.checkstyle.ControlFlowBracesCheck" />
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="tokens" value="LITERAL_IF" />
		</module>
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="severity" value="warning" />
			<property name="tokens" value="LITERAL_DO,LITERAL_FOR,LITERAL_WHILE" />
		</module>
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="tokens" value="INSTANCE_INIT,STATIC_INIT" />
		</module>
		<module name="com.etk2000.checkstyle.EmptySwitchCheck" />
		<module name="com.etk2000.checkstyle.FieldConsolidationCheck" />
		<module name="com.etk2000.checkstyle.FieldSortingCheck" />
		<module name="com.etk2000.checkstyle.InfiniteEmptyLoopCheck" />
		<module name="com.etk2000.checkstyle.InstanceofBeforeCastCheck" />
		<module name="com.etk2000.checkstyle.MethodAlphabeticalOrderCheck" />
		<module name="com.etk2000.checkstyle.MultilineCallFormattingCheck" />
		<module name="com.etk2000.checkstyle.NoFinalParametersCheck" />
		<module name="com.etk2000.checkstyle.NoFinalParametersCheck">
			<property name="severity" value="warning" />
			<property name="tokens" value="FOR_INIT" />
		</module>
		<module name="com.etk2000.checkstyle.NoArrayTrailingCommaCheck" />
		<module name="com.etk2000.checkstyle.NoBlankLineBetweenSingleCasesCheck" />
		<module name="com.etk2000.checkstyle.NoCaseBracesCheck" />
		<module name="com.etk2000.checkstyle.NoUnnecessaryThisCheck" />
		<module name="com.etk2000.checkstyle.OverloadMethodOrderCheck" />
		<module name="com.etk2000.checkstyle.PreferImportCheck" />
		<module name="com.etk2000.checkstyle.PreferLambdaCheck" />
		<module name="com.etk2000.checkstyle.PreferLiteralSuffixCheck" />
		<module name="com.etk2000.checkstyle.PreferMathMethodCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>
		<module name="com.etk2000.checkstyle.PreferPatternMatchingInstanceofCheck" />
		<module name="com.etk2000.checkstyle.PreferPrefixIncrementCheck" />
		<module name="com.etk2000.checkstyle.PreferRecordCheck" />
		<module name="com.etk2000.checkstyle.PreferSpecificApiCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>
		<module name="com.etk2000.checkstyle.PreferStandardCharsetsCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>
		<module name="com.etk2000.checkstyle.PreferVarCheck" />
		<module name="com.etk2000.checkstyle.RedundantCastCheck" />
		<module name="com.etk2000.checkstyle.RedundantNumericSuffixCheck" />
		<module name="com.etk2000.checkstyle.SwitchCaseOrderCheck" />

		<!-- Built-in checks -->
		<module name="AvoidNoArgumentSuperConstructorCall" />
		<module name="CovariantEquals" />
		<module name="EmptyLineSeparator">
			<property name="allowNoEmptyLineBetweenFields" value="true" />
			<property name="allowMultipleEmptyLines" value="false" />
			<property name="allowMultipleEmptyLinesInsideClassMembers" value="false" />
		</module>
		<module name="ExplicitInitialization" />
		<module name="FinalLocalVariable">
			<property name="validateEnhancedForLoopVariable" value="false" />
		</module>
		<module name="HexLiteralCase" />
		<module name="IllegalSymbol" />
		<module name="MissingOverride" />
		<module name="MissingOverrideOnRecordAccessor" />
		<module name="ModifierOrder" />
		<module name="NoEnumTrailingComma" />
		<module name="NumericalPrefixesInfixesSuffixesCharacterCase" />
		<module name="OneStatementPerLine" />
		<module name="PatternVariableAssignment" />
		<module name="RedundantImport" />
		<module name="RedundantModifier" />
		<module name="RightCurly">
			<property name="option" value="alone" />
			<property name="tokens" value="LITERAL_ELSE,LITERAL_CATCH,LITERAL_FINALLY" />
		</module>
		<module name="SimplifyBooleanExpression" />
		<module name="StringLiteralEquality" />
		<module name="UnnecessaryNullCheckWithInstanceOf" />
		<module name="UnusedImports" />
		<module name="UpperEll" />
		<module name="UseEnhancedSwitch" />
	</module>
</module>