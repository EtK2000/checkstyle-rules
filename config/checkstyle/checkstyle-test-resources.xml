<?xml version="1.0"?><!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Lightweight config for test resource files (src/test/resources).
     Only enforces structural/ordering rules that all test inputs should follow,
     not the rules that violation test inputs intentionally break. -->
<module name="Checker">
	<property name="charset" value="UTF-8" />
	<property name="severity" value="error" />

	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/suppressions-test-resources.xml" />
	</module>

	<module name="TreeWalker">
		<module name="com.etk2000.checkstyle.AnnotationAlphabeticalOrderCheck" />
		<module name="com.etk2000.checkstyle.MethodAlphabeticalOrderCheck" />
		<module name="com.etk2000.checkstyle.OverloadMethodOrderCheck" />
	</module>
</module>