#!/usr/bin/env bash
# Read one case slice out of a fixture file instead of the whole file.
#
#   tools/slice list                     topics and their slice counts
#   tools/slice list <topic|file>        slice names in the topic's canonical input (--all for every file)
#   tools/slice show <topic|file> <name> the slice, from every sliced file in the topic
#   tools/slice find <pattern>           slice names matching a regex, across all topics
#
# `grep -a` throughout: the shell grep is a ugrep wrapper that silently skips files it reads as binary.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INPUTS="$ROOT/src/test/resources/com/etk2000/checkstyle/inputs"
END_MARKER='// === end ==='

die() { printf '%s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# A topic name, a topic dir, or a fixture file all resolve to something usable.
resolve_dir() {
	if [ -f "$1" ]; then dirname "$1"
	elif [ -d "$1" ]; then printf '%s' "$1"
	elif [ -d "$INPUTS/$1" ]; then printf '%s' "$INPUTS/$1"
	else die "no such topic or file: $1"
	fi
}

sliced_files() {
	local dir="$1" f rank
	for f in "$dir"/*.java; do
		[ -e "$f" ] || continue
		grep -aqE '^// === case: ' "$f" || continue
		case "$(basename "$f")" in
			*.in.java) rank=1 ;;
			*.out.java) rank=2 ;;
			*.fixed.java) rank=3 ;;
			*) rank=4 ;;
		esac
		printf '%s\t%s\n' "$rank" "$f"
	done | sort -k1,1n -k2,2 | cut -f2
}

canonical_file() {
	local dir="$1"
	for name in cases.in.java fragments.in.java; do
		[ -f "$dir/$name" ] && { printf '%s' "$dir/$name"; return; }
	done
	sliced_files "$dir" | head -1
}

# Echoes "start end" (body line numbers, markers excluded), or nothing when absent.
slice_range() {
	local file="$1" name="$2" start offset
	start=$(grep -axnF "// === case: $name ===" "$file" | cut -d: -f1 || true)
	[ -n "$start" ] || return 0
	offset=$(tail -n +$((start + 1)) "$file" | grep -axnF "$END_MARKER" | head -1 | cut -d: -f1 || true)
	[ -n "$offset" ] || die "unterminated slice '$name' in $file (line $start has no '$END_MARKER')"
	printf '%s %s' $((start + 1)) $((start + offset - 1))
}

cmd_list() {
	local all=0 target=""
	for arg in "$@"; do
		case "$arg" in
			--all) all=1 ;;
			*) target="$arg" ;;
		esac
	done

	if [ -z "$target" ]; then
		local dir count
		for dir in "$INPUTS"/*/; do
			count=$({ grep -acE '^// === case: ' "$dir"*.java 2>/dev/null || true; } | awk -F: '{s += $NF} END {print s + 0}')
			[ "${count:-0}" -gt 0 ] && printf '%5d  %s\n' "$count" "$(basename "$dir")" || true
		done | sort -rn
		return
	fi

	local dir files f
	dir=$(resolve_dir "$target")
	if [ -f "$target" ]; then files="$target"
	elif [ "$all" = 1 ]; then files=$(sliced_files "$dir")
	else files=$(canonical_file "$dir")
	fi

	[ -n "$files" ] || die "no sliced fixtures in ${dir#"$ROOT"/} (clean files carry no case markers)"

	for f in $files; do
		printf '\n%s\n' "${f#"$ROOT"/}"
		{ grep -anE '^// === case: ' "$f" || true; } \
			| sed -E 's|^([0-9]+):// === case: (.*) ===$|  \1  \2|'
	done
}

cmd_show() {
	[ $# -ge 2 ] || die "usage: tools/slice show <topic|file> <name>"
	local target="$1" name="$2" dir files f range found=0
	dir=$(resolve_dir "$target")
	if [ -f "$target" ]; then files="$target"; else files=$(sliced_files "$dir"); fi

	for f in $files; do
		range=$(slice_range "$f" "$name")
		[ -n "$range" ] || continue
		found=1
		set -- $range
		printf '\n── %s:%s-%s ──\n' "${f#"$ROOT"/}" "$1" "$2"
		sed -n "$1,$2p" "$f"
	done

	if [ "$found" = 0 ]; then
		printf 'no slice named %s in %s\n' "$name" "${dir#"$ROOT"/}" >&2
		printf 'closest names:\n' >&2
		grep -ahoE '^// === case: .*[^ ]' $(sliced_files "$dir") 2>/dev/null \
			| sed -E 's|^// === case: (.*) ===$|\1|' | grep -ai -- "$name" | sort -u | head -10 >&2 || true
		exit 1
	fi
}

cmd_find() {
	[ $# -ge 1 ] || die "usage: tools/slice find <pattern>"
	# One recursive grep, not a per-file loop: a file with no match must not end the scan.
	{ grep -raoE '^// === case: [^=]+ ===' "$INPUTS" --include='*.java' || true; } \
		| sed -E 's|^.*/inputs/([^/]+)/[^:]*:// === case: (.*) ===$|\1	\2|' \
		| { grep -aiE -- "$1" || true; } \
		| sort -u | awk -F'\t' '{printf "%-30s %s\n", $1, $2}'
}

[ $# -ge 1 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
	list) cmd_list "$@" ;;
	show) cmd_show "$@" ;;
	find) cmd_find "$@" ;;
	-h|--help|help) usage ;;
	*) die "unknown subcommand: $sub (try list, show, find)" ;;
esac
