<?xml version="1.0"?><!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
	<property name="charset" value="UTF-8" />
	<property name="severity" value="error" />

	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/suppressions.xml" />
		<property name="optional" value="true" />
	</module>

	<!-- TABs for indentation (flag lines starting with spaces, excluding Javadoc/block comment continuation).
		 Regex: `^ ` matches a line starting with a space. `(?!\*)` excludes Javadoc/block comment
		 continuation lines (which start with ` *`). `(?!@)` excludes annotation lines that
		 Checkstyle itself indents with spaces in error messages. -->
	<module name="RegexpSingleline">
		<property name="id" value="NoSpaceIndent" />
		<property name="format" value="^ (?!\*)(?!@)" />
		<property name="message" value="Use TABs for indentation, not spaces." />
	</module>

	<!-- No blank line after class/interface/enum/record opening brace -->
	<module name="RegexpMultiline">
		<property name="id" value="NoBlankLineAfterClassBrace" />
		<property name="format" value="(class|interface|enum|record)\s+\w[^{]*\{\s*\n\s*\n" />
		<property name="message" value="No blank line at start of a class/interface/enum/record." />
	</module>

	<!-- No blank line before closing brace -->
	<module name="RegexpMultiline">
		<property name="id" value="NoBlankLineBeforeClosingBrace" />
		<property name="format" value="\n[^\S\n]*\n[^\S\n]*\}" />
		<property name="message" value="No blank line before closing brace." />
	</module>

	<!-- No double blank lines -->
	<module name="RegexpMultiline">
		<property name="id" value="NoDoubleBlankLines" />
		<property name="format" value="\n\s*\n\s*\n" />
		<property name="message" value="No double blank lines." />
	</module>

	<!-- Blank line after break; before next case/default.
		 Regex: `break\s*;` matches a break statement. `\n` then a new line immediately follows
		 (no blank line). `[^\S\n]*` matches horizontal whitespace only — `[^\S]` is "not
		 non-whitespace" (i.e. whitespace), and adding `\n` to the exclusion makes it "whitespace
		 except newline" (spaces/tabs). Then `case ` or `default` follows directly. -->
	<module name="RegexpMultiline">
		<property name="id" value="BlankLineAfterBreak" />
		<property name="format" value="break\s*;\n[^\S\n]*(case |default[\s:])" />
		<property name="message"
			value="Add a blank line after break; before the next case/default." />
	</module>

	<!-- No trailing whitespace (also ensures blank lines are completely empty) -->
	<module name="RegexpSingleline">
		<property name="id" value="NoTrailingWhitespace" />
		<property name="format" value="[ \t]+$" />
		<property name="message" value="No trailing whitespace." />
	</module>

	<!-- No trailing newline at end of file -->
	<module name="RegexpMultiline">
		<property name="id" value="NoTrailingNewline" />
		<property name="format" value="\n\z" />
		<property name="message" value="File must not end with a trailing newline." />
	</module>

	<!-- Enforce consistent line endings (LF) -->
	<module name="LineEnding" />

	<module name="TreeWalker">
		<!-- Custom: Stacked annotation formatting (own line, no blank lines, alphabetical) -->
		<module name="com.etk2000.checkstyle.AnnotationOwnLineCheck" />

		<!-- Custom: Java-style array declarations (int[] x, not int x[]) -->
		<module name="com.etk2000.checkstyle.ArrayTypeStyleCheck" />

		<!-- Custom: Inline annotation formatting (same line, alphabetical) -->
		<module name="com.etk2000.checkstyle.AnnotationSameLineCheck" />

		<!-- Custom: Class structure must follow defined section order -->
		<module name="com.etk2000.checkstyle.ClassStructureOrderCheck" />

		<!-- Custom: Constructor/initializer field assignments must be ordered -->
		<module name="com.etk2000.checkstyle.ConstructorAssignmentOrderCheck" />

		<!-- Custom: Control flow brace rules -->
		<module name="com.etk2000.checkstyle.ControlFlowBracesCheck" />

		<!-- Custom: instanceof should come before cast to same type in && -->
		<module name="com.etk2000.checkstyle.InstanceofBeforeCastCheck" />

		<!-- Custom: No empty if/else bodies -->
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="tokens" value="LITERAL_IF" />
		</module>

		<!-- Custom: Warn on empty while/for/do-while bodies (spin-waits are a valid use case) -->
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="severity" value="warning" />
			<property name="tokens" value="LITERAL_DO,LITERAL_FOR,LITERAL_WHILE" />
		</module>

		<!-- Custom: No empty initializer blocks -->
		<module name="com.etk2000.checkstyle.EmptyBodyCheck">
			<property name="tokens" value="INSTANCE_INIT,STATIC_INIT" />
		</module>

		<!-- Custom: Empty infinite loops are errors (for(;;), while(true), do;while(true)) -->
		<module name="com.etk2000.checkstyle.InfiniteEmptyLoopCheck" />

		<!-- Custom: JIT-unfriendly patterns and unnecessary allocations -->
		<module name="com.etk2000.checkstyle.JitInefficiencyCheck" />

		<!-- Custom: Lambda parameters should use implicit types (or var with annotations) -->
		<module name="com.etk2000.checkstyle.LambdaParameterTypeCheck" />

		<!-- Custom: Combine same-type uninitialized fields on one line -->
		<module name="com.etk2000.checkstyle.FieldConsolidationCheck" />

		<!-- Custom: Fields sorted by immutability, type, and name -->
		<module name="com.etk2000.checkstyle.FieldSortingCheck" />

		<!-- Custom: No empty switch statements -->
		<module name="com.etk2000.checkstyle.EmptySwitchCheck" />

		<!-- Custom: For-each loops and try-with-resources must use var -->
		<module name="com.etk2000.checkstyle.PreferVarCheck">
			<property name="allowedMethods" value="findViewById,findViewWithTag,getArgument,getSystemService,requireViewById" />
		</module>

		<!-- Custom: Methods sorted alphabetically within their section -->
		<module name="com.etk2000.checkstyle.MethodAlphabeticalOrderCheck" />

		<!-- Custom: Multiline call/signature formatting -->
		<module name="com.etk2000.checkstyle.MultilineCallFormattingCheck" />

		<!-- Custom: Parameters and for-each variables must not be final (error) -->
		<module name="com.etk2000.checkstyle.NoFinalParametersCheck" />

		<!-- Custom: For-loop init variables should not be final (warning, conflicts with FinalLocalVariable) -->
		<module name="com.etk2000.checkstyle.NoFinalParametersCheck">
			<property name="severity" value="warning" />
			<property name="tokens" value="FOR_INIT" />
		</module>

		<!-- Custom: No trailing comma in array initializers -->
		<module name="com.etk2000.checkstyle.NoArrayTrailingCommaCheck" />

		<!-- Custom: No trailing semicolon in enum without body declarations -->
		<module name="com.etk2000.checkstyle.NoEnumTrailingSemicolonCheck" />

		<!-- Prefer enhanced (arrow) switch syntax when possible -->
		<module name="UseEnhancedSwitch" />

		<!-- Custom: Prefer StandardCharsets constants over charset name strings -->
		<module name="com.etk2000.checkstyle.PreferStandardCharsetsCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>

		<!-- Custom: Prefer static imports for well-known utility methods -->
		<module name="com.etk2000.checkstyle.PreferStaticImportCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>

		<!-- Custom: Prefer bulk operations over element-by-element loops -->
		<module name="com.etk2000.checkstyle.PreferBulkOperationCheck" />

		<!-- Custom: Use assertEquals with exact values instead of assertTrue/assertFalse with comparisons -->
		<module name="com.etk2000.checkstyle.PreferExactAssertionCheck" />

		<!-- Custom: Prefer specific API methods over generic ones -->
		<module name="com.etk2000.checkstyle.PreferSpecificApiCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>

		<!-- Custom: Prefer Math.max/min/abs/clamp over manual ternary comparisons -->
		<module name="com.etk2000.checkstyle.PreferMathMethodCheck">
			<property name="minSdk" value="${minSdk}" />
		</module>

		<!-- Custom: Prefer pattern matching instanceof over cast-after-check -->
		<module name="com.etk2000.checkstyle.PreferPatternMatchingInstanceofCheck" />

		<!-- Custom: Prefer record classes over classes with all final fields -->
		<module name="com.etk2000.checkstyle.PreferRecordCheck" />

		<!-- Custom: Record component layout and brace formatting -->
		<module name="com.etk2000.checkstyle.RecordFormattingCheck" />

		<!-- Custom: Prefer literal suffix over widening cast in arithmetic -->
		<module name="com.etk2000.checkstyle.PreferLiteralSuffixCheck" />

		<!-- Custom: Prefer collection interface types over concrete types in method/constructor signatures -->
		<module name="com.etk2000.checkstyle.PreferCollectionInterfaceCheck" />

		<!-- Custom: Replace if returning boolean literals with direct return of the condition -->
		<module name="com.etk2000.checkstyle.PreferDirectBooleanReturnCheck" />

		<!-- Custom: Prefer do-while when a statement is duplicated before a while loop -->
		<module name="com.etk2000.checkstyle.PreferDoWhileCheck" />

		<!-- Custom: Prefer imports over fully qualified names (warning, not error) -->
		<module name="com.etk2000.checkstyle.PreferImportCheck">
			<property name="severity" value="warning" />
		</module>

		<!-- Custom: Prefer lambda expression over anonymous functional interface -->
		<module name="com.etk2000.checkstyle.PreferLambdaCheck" />

		<!-- Custom: No blank line between consecutive single-line switch cases -->
		<module name="com.etk2000.checkstyle.NoBlankLineBetweenSingleCasesCheck" />

		<!-- Custom: No unnecessary braces in case/default blocks -->
		<module name="com.etk2000.checkstyle.NoCaseBracesCheck" />

		<!-- Custom: No unnecessary this. usage -->
		<module name="com.etk2000.checkstyle.NoUnnecessaryThisCheck" />

		<!-- Custom: Overloaded methods ordered by ascending parameter count -->
		<module name="com.etk2000.checkstyle.OverloadMethodOrderCheck" />

		<!-- Custom: Prefer prefix increment/decrement over postfix -->
		<module name="com.etk2000.checkstyle.PreferPrefixIncrementCheck" />

		<!-- Custom: Flag redundant type casts (same-type or implicit widening) -->
		<module name="com.etk2000.checkstyle.RedundantCastCheck" />

		<!-- Custom: Flag redundant annotation syntax (@A() and @A(value = x)) -->
		<module name="com.etk2000.checkstyle.RedundantAnnotationSyntaxCheck" />

		<!-- Custom: Flag redundant array creation for varargs calls -->
		<module name="com.etk2000.checkstyle.RedundantArrayCreationCheck" />

		<!-- Custom: Flag redundant if-else with equality condition -->
		<module name="com.etk2000.checkstyle.RedundantEqualityBranchCheck" />

		<!-- Custom: Flag redundant numeric suffixes (L, f, d) -->
		<module name="com.etk2000.checkstyle.RedundantNumericSuffixCheck" />

		<!-- Custom: Switch cases must be sorted -->
		<module name="com.etk2000.checkstyle.SwitchCaseOrderCheck" />

		<!-- Custom: All types must have a thread annotation -->
		<module name="com.etk2000.checkstyle.ThreadAnnotationCheck" />

		<!-- Flag redundant super() calls -->
		<module name="AvoidNoArgumentSuperConstructorCall" />

		<!-- Flag equals(Foo) without equals(Object) -->
		<module name="CovariantEquals" />

		<!-- Flag explicit initialization to default values (int x = 0, Object o = null) -->
		<module name="ExplicitInitialization" />

		<!-- Enforce uppercase hex literal digits (A-F, not a-f) -->
		<module name="HexLiteralCase" />

		<!-- Block emoji and special Unicode symbols in code -->
		<module name="IllegalSymbol" />

		<!-- Require @Override on all overriding methods -->
		<module name="MissingOverride" />

		<!-- Require @Override on explicitly declared record accessor methods -->
		<module name="MissingOverrideOnRecordAccessor" />

		<!-- Enforce JLS modifier order (public static final, not final static public) -->
		<module name="ModifierOrder" />

		<!-- Enforce lowercase 0x/0b prefixes and uppercase L suffix -->
		<module name="NumericalPrefixesInfixesSuffixesCharacterCase" />

		<!-- One statement per line -->
		<module name="OneStatementPerLine" />

		<!-- Flag reassignment of pattern variables from instanceof -->
		<module name="PatternVariableAssignment" />

		<!-- Flag duplicate or java.lang imports -->
		<module name="RedundantImport" />

		<!-- Flag implied modifiers (public on interface methods, etc.) -->
		<module name="RedundantModifier" />

		<!-- Simplify boolean expressions (b == true, !false, etc.) -->
		<module name="SimplifyBooleanExpression" />

		<!-- Flag == on String comparisons -->
		<module name="StringLiteralEquality" />

		<!-- Flag redundant null checks paired with instanceof -->
		<module name="UnnecessaryNullCheckWithInstanceOf" />

		<!-- No unused imports -->
		<module name="UnusedImports" />

		<!-- No unused local variables -->
		<module name="UnusedLocalVariable" />

		<!-- Require L not l for long literals -->
		<module name="UpperEll" />

		<!-- Blank line between methods/constructors/classes -->
		<module name="EmptyLineSeparator">
			<property name="allowNoEmptyLineBetweenFields" value="true" />
			<property name="allowMultipleEmptyLines" value="false" />
			<property name="allowMultipleEmptyLinesInsideClassMembers" value="false" />
		</module>

		<!-- else/catch/finally on own line -->
		<module name="RightCurly">
			<property name="option" value="alone" />
			<property name="tokens" value="LITERAL_ELSE,LITERAL_CATCH,LITERAL_FINALLY" />
		</module>

		<!-- No trailing comma after last enum value -->
		<module name="NoEnumTrailingComma" />

		<!-- Local variables final wherever possible (except for-each iteration variables) -->
		<module name="FinalLocalVariable">
			<property name="validateEnhancedForLoopVariable" value="false" />
		</module>

	</module>
</module>